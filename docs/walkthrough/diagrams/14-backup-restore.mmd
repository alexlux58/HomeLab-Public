flowchart TB
  subgraph app["Application layer (nightly, append-only)"]
    a300["VM 300: SQLite + MariaDB dump 02:45"]
    a310["VM 310: TSDB snapshot + grafana.db 03:30"]
    a330["VM 330: pg_dump 03:45"]
    aarr["*arr zips 05:40 to media-backups"]
    aplex["Plex DB + Preferences 04:30"]
    abao["OpenBao encrypted Raft (after init)"]
  end
  subgraph vm["Guest layer (vzdump, keep-all=1)"]
    vz["Daily 03:15-05:25; VM 290 weekly Sun 01:00"]
  end
  subgraph store["Storage layer"]
    v1[("NAS Volume 1<br/>single disk: no redundancy")]
    v2[("NAS Volume 2 RAID1<br/>Media, media-backups")]
  end
  a300 & a310 & a330 --> vz --> v1
  aarr & aplex --> v2
  abao --> v1
  reader["One confirmed PVE node<br/>forced SSH: list/get only"]
  tower[("workstation D: second copy<br/>daily / missed-start catch-up<br/>100 GB reserve; never delete")]
  v1 -. read-only mount .-> reader
  tower -. outbound SSH pull / SHA-256 verify .-> reader
  Note["D3 approved; installation awaits key and SSH access<br/>D: is local, neither off-site nor immutable"]
  Note -.-> tower
  restore["Restore drills: isolated VMID, NICs link_down,<br/>verify, then promote (L6)"]
  v1 & v2 & tower -.-> restore
