// media-vm telemetry (ADR-0006): scrape local exporters and push to
// Prometheus on VM 310. The guest is behind VirtualBox NAT and workstation
// sleeps, so absence of these series is expected and must not page.

prometheus.scrape "media" {
  targets = [
    {"__address__" = "exportarr-radarr:9707", "job" = "exportarr", "app" = "radarr"},
    {"__address__" = "exportarr-prowlarr:9708", "job" = "exportarr", "app" = "prowlarr"},
    {"__address__" = "node-exporter:9100", "job" = "node"},
  ]
  scrape_interval = "60s"
  forward_to      = [prometheus.remote_write.observability.receiver]
}

prometheus.remote_write "observability" {
  endpoint {
    url = "http://192.168.0.31:9090/api/v1/write"
  }
  external_labels = {
    host = "media-vm",
  }
}
