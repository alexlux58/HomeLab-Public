{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(terraform import:*)",
      "Bash(tofu apply:*)",
      "Bash(tofu destroy:*)",
      "Bash(tofu import:*)",
      "Bash(bao operator:*)",
      "Bash(pvecm:*)",
      "Bash(qm destroy:*)",
      "Bash(pct destroy:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Read(./**/*.tfstate)",
      "Read(./**/*.tfstate.*)",
      "Read(./**/.env)",
      "Read(./**/*.env)",
      "Read(./**/*.tfvars)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(~/.ssh/**)",
      "Read(./**/artifacts/**)",
      "Read(./**/host-configs/**)",
      "Read(./**/Preferences.xml)",
      "Read(./**/config.xml)",
      "Read(./.runtime/radarr/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Read|Grep|Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.sh\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
