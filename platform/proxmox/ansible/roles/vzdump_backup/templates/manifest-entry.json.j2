{
  "generation": "{{ vzdump_backup_generation }}",
  "inventory_host": "{{ inventory_hostname }}",
  "source_ip": "{{ ansible_host }}",
  "source_hostname": "{{ expected_hostname }}",
  "original_vmid": {{ entry_guest.vmid }},
  "guest_name": "{{ entry_guest.name }}",
  "guest_type": "{{ entry_guest.type }}",
  "archive_path": "{{ entry_archive.path }}",
  "archive_size_bytes": {{ entry_archive.size }},
  "timestamp": "{{ '%Y-%m-%dT%H:%M:%SZ' | strftime(entry_archive.mtime | int, utc=true) }}",
  "sha256": "{{ entry_archive.checksum }}",
  "vzdump_backup_mode": "{{ vzdump_backup_mode }}",
  "compression": "{{ vzdump_compress }}",
  "original_running_state": "{{ entry_state }}",
  "expected_disks": {{ entry_config
      | regex_findall('^(?:scsi|virtio|ide|sata|efidisk|tpmstate|rootfs|mp)\d*:.*$', multiline=True)
      | unique | list | to_json }},
  "bridge_dependency": {{ entry_config
      | regex_findall('bridge=([A-Za-z0-9_.-]+)')
      | unique | list | to_json }},
  "passthrough_dependency": {{ entry_config
      | regex_findall('^(?:hostpci|usb)\d+:.*$', multiline=True)
      | to_json }},
  "custom_args": {{ (entry_config | regex_findall('^args:\s*(.*)$', multiline=True) | first | default('')) | to_json }},
  "planned_vmid": {{ planned_vmid | default(entry_guest.vmid) }},
  "planned_restore_node": "{{ planned_restore_node | default(expected_hostname) }}",
  "verification": {
    "ok": null,
    "method": "pending",
    "rc": null,
    "message": "not yet verified — run playbooks/25-verify-backups.yml"
  }
}
