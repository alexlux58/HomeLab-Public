[Unit]
Description=Encrypted OpenBao Raft snapshot to Synology
After=network-online.target openbao.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
Environment=BAO_ADDR=https://{{ inventory_hostname }}.{{ openbao_domain }}:8200
Environment=BAO_CACERT=/etc/openbao/tls/ca.pem
ExecStart={{ openbao_backup_script_path }} \
  --token-file {{ openbao_backup_agent_token_file }} \
  --age-recipient-file {{ openbao_backup_age_recipient_file }} \
  --local-dir {{ openbao_backup_local_dir }} \
  --sftp-host {{ openbao_synology_ip }} \
  --sftp-port {{ openbao_synology_ssh_port }} \
  --sftp-user {{ openbao_synology_backup_user }} \
  --sftp-key {{ openbao_backup_sftp_key_file }} \
  --sftp-known-hosts {{ openbao_backup_sftp_known_hosts_file }} \
  --remote-dir {{ openbao_synology_backup_path }}
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths={{ openbao_backup_local_dir }}
