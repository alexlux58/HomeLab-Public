[Unit]
Description=OpenBao Agent for Raft snapshot authentication
After=network-online.target openbao.service
Wants=network-online.target

[Service]
Type=notify
User=root
Group=root
RuntimeDirectory=openbao-agent-backup
RuntimeDirectoryMode=0700
ExecStart=/usr/local/bin/bao agent -config=/etc/openbao/agent/backup/agent.hcl
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/run/openbao-agent-backup

[Install]
WantedBy=multi-user.target

