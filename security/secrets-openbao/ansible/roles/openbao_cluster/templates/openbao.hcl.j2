ui = true
disable_cache = false
default_lease_ttl = "1h"
max_lease_ttl = "24h"
api_addr = "https://{{ inventory_hostname }}.{{ openbao_domain }}:8200"
cluster_addr = "https://{{ inventory_hostname }}.{{ openbao_domain }}:8201"

listener "tcp" {
  address = "{{ ansible_host }}:8200"
  cluster_address = "{{ ansible_host }}:8201"
  tls_cert_file = "/etc/openbao/tls/server.pem"
  tls_key_file = "/etc/openbao/tls/server-key.pem"
  tls_client_ca_file = "/etc/openbao/tls/ca.pem"
  tls_min_version = "tls12"
  tls_max_version = "tls13"
  unauthenticated_metrics_access = false
  x_forwarded_for_reject_not_present = false
  x_forwarded_for_trusted_proxies = ["{{ openbao_lan_cidr }}"]
}

storage "raft" {
  path = "/var/lib/openbao/raft"
  node_id = "{{ openbao_node_id }}"
  performance_multiplier = 1
{% for member in openbao_cluster_members %}
  retry_join {
    leader_api_addr = "https://{{ member.name }}.{{ openbao_domain }}:8200"
    leader_ca_cert_file = "/etc/openbao/tls/ca.pem"
    leader_tls_servername = "{{ member.name }}.{{ openbao_domain }}"
  }
{% endfor %}
}

telemetry {
  prometheus_retention_time = "24h"
  disable_hostname = false
}

audit "file" "local-file" {
  description = "Local authoritative audit stream shipped by Alloy"
  options = {
    file_path = "/var/log/openbao/audit.json"
    mode = "0640"
    log_raw = "false"
  }
}

