global_defs {
    router_id {{ openbao_node_id }}
    enable_script_security
    script_user root
}

vrrp_script check_haproxy {
    script "/usr/bin/pgrep haproxy"
    interval 2
    fall 2
    rise 2
    weight -50
}

vrrp_instance OPENBAO_API {
    state BACKUP
    interface {{ ansible_default_ipv4.interface }}
    virtual_router_id 51
    priority {{ openbao_keepalived_priority }}
    advert_int 1
    unicast_src_ip {{ ansible_host }}
    unicast_peer {
{% for member in openbao_cluster_members if member.address != ansible_host %}
        {{ member.address }}
{% endfor %}
    }
    virtual_ipaddress {
        {{ openbao_api_vip }}/24 dev {{ ansible_default_ipv4.interface }}
    }
    track_script {
        check_haproxy
    }
}
