pid_file = "/run/openbao-agent/backup/agent.pid"

vault {
  address = "https://bao.lab.example.com:8200"
  ca_cert = "/etc/openbao/tls/ca.pem"
}

auto_auth {
  method "approle" {
    config = {
      role_id_file_path = "/etc/openbao/agent/backup/role-id"
      secret_id_file_path = "/etc/openbao/agent/backup/secret-id"
      remove_secret_id_file_after_reading = false
    }
  }

  sink "file" {
    config = {
      path = "/run/openbao-agent/backup/token"
      mode = 0600
    }
  }
}

