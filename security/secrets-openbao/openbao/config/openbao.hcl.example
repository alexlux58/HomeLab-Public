# Rendered per node by ansible/roles/openbao_cluster. This copy documents the
# contract; it is not deployed because addresses and node IDs are host-specific.
ui = true

storage "raft" {
  path = "/var/lib/openbao/raft"
  node_id = "node-specific"
}

listener "tcp" {
  address = "node-address:8200"
  tls_cert_file = "/etc/openbao/tls/server.pem"
  tls_key_file = "/etc/openbao/tls/server-key.pem"
  tls_min_version = "tls12"
}

